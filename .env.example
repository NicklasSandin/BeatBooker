# BeatBooker Environment Configuration
# Copy this to .env.local and fill in your keys

# --- Live Data Provider (Optional) ---
# Without this key, BeatBooker runs on a worldwide-aware simulated data
# engine with zero setup. Add a free LiteAPI (Nuitee) sandbox key (no credit
# card required) to search real hotel/apartment inventory instead:
# https://dashboard.liteapi.travel
# LITEAPI_KEY=

# --- App Settings ---
NEXT_PUBLIC_APP_NAME=BeatBooker
NEXT_PUBLIC_APP_URL=http://localhost:3000
