# BeatBooker Environment Configuration
# Copy this to .env.local and fill in your keys

# --- MCP Connectors (Free - No Keys Required) ---
# OpenBnB - Free Airbnb-style rental data
OPENBNB_MCP_URL=https://mcp.openbnb.ai/mcp

# Gondola - Free hotel data & price comparison
GONDOLA_MCP_URL=https://mcp.gondola.ai/mcp

# --- Optional Paid Upgrades ---
# AirROI - Demand data for rentals (get key from airroi.com)
# AIRROI_API_KEY=

# SerpApi - Better hotel cross-site pricing (get key from serpapi.com)
# SERPAPI_API_KEY=

# Makcorps - Hotel price comparison API (get key from makcorps.com)
# MAKCORPS_API_KEY=

# --- Browser Automation (Optional) ---
# Playwright/Puppeteer proxy for heavy use
# BROWSER_PROXY_URL=

# --- App Settings ---
NEXT_PUBLIC_APP_NAME=BeatBooker
NEXT_PUBLIC_APP_URL=http://localhost:3000
