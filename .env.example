# BeatBooker Environment Configuration
# Copy this to .env.local and fill in your keys

# --- Live Data Provider (Optional) ---
# Without this key, BeatBooker runs on a worldwide-aware simulated data
# engine with zero setup. Add a free LiteAPI (Nuitee) sandbox key (no credit
# card required) to search real hotel/apartment inventory instead:
# https://dashboard.liteapi.travel
# LITEAPI_KEY=

# --- Affiliate Monetization (Optional) ---
# Travelpayouts marker (partner ID) — sign up free, no traffic minimum:
# https://www.travelpayouts.com. Enables a "Compare live deals" link to
# Hotellook's real hotel search, tagged with your affiliate marker.
# A direct Booking.com Affiliate Partner Program integration is planned
# separately and not yet wired up.
# NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=

# Travelpayouts "Drive" — their on-site monetization widget script, pulled
# from your Drive project dashboard (a different feature from the marker
# above). Site-wide, loads on every page. Leave unset to disable.
# NEXT_PUBLIC_TRAVELPAYOUTS_DRIVE_SRC=

# --- App Settings ---
NEXT_PUBLIC_APP_NAME=BeatBooker
NEXT_PUBLIC_APP_URL=http://localhost:3000
